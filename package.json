{
  "name": "package-tooling",
  "private": true,
  "version": "0.0.0-dev",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@wagtail/eslint-config-wagtail": "^1.0.0",
    "@wagtail/stylelint-config-wagtail": "^2.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.4",
    "stylelint": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm"
    }
  },
  "scripts": {
    "lint": "npm run lint:format && npm run lint:css && npm run lint:js",
    "lint:format": "prettier --check \"**/?(.)*.{css,scss,mjs,js,ts,tsx,json,jsonc,yaml,yml}\"",
    "lint:css": "stylelint --allow-empty-input \"**/?(.)*.{css,scss}\"",
    "format": "prettier --write \"**/?(.)*.{css,scss,mjs,js,ts,tsx,json,jsonc,yaml,yml}\"",
    "lint:js": "eslint ."
  }
}
